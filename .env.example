# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Postgres — source of truth for the database. Used directly by the `db`
# service, and by `docker-compose.yml` to compose the `app` service's
# DATABASE_URL (pointed at the `db` service instead of localhost).
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="t3-docker-scaffold"
# Host port Postgres is published on (container always listens on 5432 internally)
POSTGRES_PORT="5432"
# Host port Drizzle Studio is published on
DRIZZLE_STUDIO_PORT="4983"

# Drizzle — used by host-installed tooling (`npm run dev`, `npm run db:*`)
# connecting to Postgres via its published host port. Must be kept in sync
# with the POSTGRES_* values above. Inside docker-compose, the `app` service
# overrides this to point at the `db` service instead — see docker-compose.yml.
DATABASE_URL="postgresql://postgres:password@localhost:5432/t3-docker-scaffold"

# Model provider API keys — optional. Set whichever you have; the model
# picker only offers models whose key is present (src/lib/llm-provider).
# GOOGLE_GENERATIVE_AI_API_KEY=""
# ANTHROPIC_API_KEY=""
